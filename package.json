{
  "name": "fullorama",
  "version": "1.2.1",
  "description": "Fill your ultrawide screen with YouTube videos without distracting black bars.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "homepage": "https://github.com/sudhz/fullorama#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudhz/fullorama.git"
  },
  "bugs": {
    "url": "https://github.com/sudhz/fullorama/issues"
  },
  "keywords": [
    "fullorama",
    "chrome-extension",
    "firefox-addon",
    "youtube",
    "ultrawide",
    "zoom-to-fill",
    "manifest-v3"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/build.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "validate": "bun run typecheck && bun run test && bun run lint:firefox",
    "pack:chrome": "web-ext build --source-dir dist-chrome --artifacts-dir artifacts --filename fullorama-v{version}-chrome.zip --overwrite-dest",
    "pack:firefox": "web-ext build --source-dir dist-firefox --artifacts-dir artifacts --filename fullorama-v{version}-firefox.zip --overwrite-dest",
    "pack:source": "bun run scripts/package-source.ts",
    "pack:all": "bun run pack:chrome && bun run pack:firefox && bun run pack:source",
    "release": "bun run validate && bun run pack:all"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.13.14",
    "esbuild": "^0.25.5",
    "fflate": "^0.8.3",
    "typescript": "^5.8.3",
    "web-ext": "10.3.0"
  }
}
