{
  "manifest_version": 3,
  "name": "Fullorama for YouTube™",
  "description": "Fill your ultrawide screen with YouTube videos, without distracting black bars.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fullorama for YouTube™",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
